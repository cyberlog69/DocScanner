<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 7.0 - 11 (API 24-30).
   Scanned documents, thumbnails, OCR database and lock preferences are excluded
   from Auto Backup so private files stay on-device.
-->
<full-backup-content>
    <exclude domain="file" path="documents/"/>
    <exclude domain="file" path="thumbnails/"/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="docscanner_settings.xml"/>
</full-backup-content>